# Neon Postgres — pooled connection (usada em runtime) e direta (usada pelo Prisma Migrate)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — chave usada para assinar sessões/JWT. Gere com: npx auth secret
AUTH_SECRET=""

# Seed do admin inicial (prisma/seed.ts) — opcional, usa defaults se não definido
SEED_ADMIN_EMAIL="admin@pier7.com"
SEED_ADMIN_PASSWORD="changeme123"

# Envio de e-mail de confirmação (Resend) — opcional, sem isso o e-mail simplesmente não é enviado
RESEND_API_KEY=""
EMAIL_FROM="Pier7 <onboarding@resend.dev>"

# Upload de assets (logo, favicon, background, áudio) via Vercel Blob
BLOB_READ_WRITE_TOKEN=""
