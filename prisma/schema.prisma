generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ADMIN / AUTH
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ---------------------------------------------------------------------------
// EVENTOS
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  FULL
  FINISHED

  @@map("event_status")
}

model Event {
  id             String      @id @default(uuid())
  slug           String      @unique
  internalName   String      @map("internal_name")
  publicName     String      @map("public_name")
  date           DateTime?
  time           String?
  location       String?
  description    String?
  summary        String?
  maxParticipants Int?       @map("max_participants")
  brandName      String?     @map("brand_name")
  status         EventStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  formConfig     FormConfig?
  formFields     FormField[]
  consents       Consent[]
  branding       Branding?
  referralLinks  ReferralLink[]
  participants   Participant[]
  eventVisits    EventVisit[]
  assets         Asset[]
  certificateConfig CertificateConfig?
  ticketTypes    TicketType[]

  @@index([status])
  @@map("events")
}

model TicketType {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  name         String
  description  String?
  quota        Int?     // null = sem limite próprio, só o limite geral do evento
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@index([eventId])
  @@map("ticket_types")
}

// Templates NÃO pertencem a um evento — são reutilizáveis entre eventos futuros.
model FormTemplate {
  id                  String  @id @default(uuid())
  name                String
  description         String?
  title               String?
  subtitle            String?
  summary             String?
  additionalInfo      String? @map("additional_info")
  confirmationTitle   String? @map("confirmation_title")
  confirmationMessage String? @map("confirmation_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fields   FormTemplateField[]
  consents FormTemplateConsent[]

  @@map("form_templates")
}

model FormTemplateField {
  id           String      @id @default(uuid())
  templateId   String      @map("template_id")
  fieldKey     String      @map("field_key")
  internalName String      @map("internal_name")
  publicLabel  String      @map("public_label")
  placeholder  String?
  fieldType    String      @default("text") @map("field_type")
  status       FieldStatus @default(OPTIONAL)
  displayOrder Int         @default(0) @map("display_order")

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("form_template_fields")
}

model FormTemplateConsent {
  id           String  @id @default(uuid())
  templateId   String  @map("template_id")
  consentKey   String  @map("consent_key")
  textVersion  String  @map("text_version")
  isRequired   Boolean @default(false) @map("is_required")
  displayOrder Int     @default(0) @map("display_order")

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("form_template_consents")
}

// ---------------------------------------------------------------------------
// FORMULÁRIO
// ---------------------------------------------------------------------------

model FormConfig {
  id                 String @id @default(uuid())
  eventId            String @unique @map("event_id")
  title              String?
  subtitle           String?
  summary            String?
  additionalInfo     String? @map("additional_info")
  confirmationTitle   String? @map("confirmation_title")
  confirmationMessage String? @map("confirmation_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("form_configs")
}

enum FieldStatus {
  INACTIVE
  OPTIONAL
  REQUIRED

  @@map("field_status")
}

model FormField {
  id           String      @id @default(uuid())
  eventId      String      @map("event_id")
  fieldKey     String      @map("field_key") // ex: "name", "email", "phone", "company"
  internalName String      @map("internal_name")
  publicLabel  String      @map("public_label")
  placeholder  String?
  fieldType    String      @default("text") @map("field_type") // text | email | phone | textarea (expansível)
  status       FieldStatus @default(OPTIONAL)
  displayOrder Int         @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers ParticipantAnswer[]

  @@unique([eventId, fieldKey])
  @@index([eventId])
  @@map("form_fields")
}

model Consent {
  id          String  @id @default(uuid())
  eventId     String  @map("event_id")
  consentKey  String  @map("consent_key") // ex: "data_processing", "future_contact"
  textVersion String  @map("text_version")
  isRequired  Boolean @default(false) @map("is_required")
  displayOrder Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantConsents ParticipantConsent[]

  @@unique([eventId, consentKey])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// BRANDING / PERSONALIZAÇÃO (Etapa 7 usa, tabela já existe desde já)
// ---------------------------------------------------------------------------

model Branding {
  id      String @id @default(uuid())
  eventId String @unique @map("event_id")

  logoUrl        String? @map("logo_url")
  faviconUrl     String? @map("favicon_url")
  backgroundUrl  String? @map("background_url")
  backgroundEnabled Boolean @default(true) @map("background_enabled")
  backgroundBlur Int?    @default(0) @map("background_blur")
  backgroundOverlay Float? @default(0) @map("background_overlay")

  primaryColor   String? @map("primary_color")
  secondaryColor String? @map("secondary_color")
  buttonColor    String? @map("button_color")
  textColor      String? @map("text_color")
  backgroundColor String? @map("background_color")
  fieldColor     String? @map("field_color")

  audioUrl     String?  @map("audio_url")
  audioEnabled Boolean  @default(false) @map("audio_enabled")
  audioVolume  Float?   @default(0.5) @map("audio_volume")
  audioLoop    Boolean  @default(true) @map("audio_loop")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("branding")
}

model Asset {
  id        String   @id @default(uuid())
  eventId   String?  @map("event_id")
  url       String
  type      String   // logo | favicon | background | audio
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("assets")
}

model CertificateConfig {
  id             String  @id @default(uuid())
  eventId        String  @unique @map("event_id")
  enabled        Boolean @default(false)
  title          String  @default("Certificado de Participação")
  bodyTemplate   String  @default("Certificamos que {{nome}} participou do evento {{evento}}, realizado em {{data}}.") @map("body_template")
  signatureName  String? @map("signature_name")
  signatureRole  String? @map("signature_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("certificate_configs")
}

// ---------------------------------------------------------------------------
// LINKS DE DIVULGAÇÃO
// ---------------------------------------------------------------------------

model ReferralLink {
  id           String  @id @default(uuid())
  eventId      String  @map("event_id")
  refCode      String  @map("ref_code")
  internalName String  @map("internal_name")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants Participant[]
  visits       EventVisit[]

  @@unique([eventId, refCode])
  @@index([eventId])
  @@map("referral_links")
}

model EventVisit {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  referralLinkId String?  @map("referral_link_id")
  createdAt      DateTime @default(now()) @map("created_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  referralLink ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([referralLinkId])
  @@map("event_visits")
}

// ---------------------------------------------------------------------------
// PARTICIPANTES
// ---------------------------------------------------------------------------

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WAITLISTED

  @@map("registration_status")
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT

  @@map("attendance_status")
}

model Participant {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  referralLinkId     String?            @map("referral_link_id")
  ticketTypeId       String?            @map("ticket_type_id")
  registrationStatus RegistrationStatus @default(REGISTERED) @map("registration_status")
  attendanceStatus   AttendanceStatus   @default(PENDING) @map("attendance_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  referralLink ReferralLink?       @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  ticketType   TicketType?         @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  answers      ParticipantAnswer[]
  consents     ParticipantConsent[]

  @@index([eventId])
  @@index([referralLinkId])
  @@index([ticketTypeId])
  @@map("participants")
}

model ParticipantAnswer {
  id            String @id @default(uuid())
  participantId String @map("participant_id")
  formFieldId   String @map("form_field_id")
  value         String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  formField   FormField   @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@unique([participantId, formFieldId])
  @@index([participantId])
  @@map("participant_answers")
}

model ParticipantConsent {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  consentId     String   @map("consent_id")
  accepted      Boolean
  acceptedAt    DateTime @default(now()) @map("accepted_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  consent     Consent     @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@unique([participantId, consentId])
  @@map("participant_consents")
}
